---
import { projects } from '../data/projects';
import ProjectCard from './projects/ProjectCard.astro';
import ProjectModal from './projects/ProjectModal.astro';

const visibleProjects = [...projects, ...projects];
---

<section id="proyectos" class="panel section-block projects-section" aria-labelledby="projects-title">
  <h2 id="projects-title">
    <span class="lang-es">Proyectos</span><span class="lang-en">Featured</span>
    <em><span class="lang-es">Destacados</span><span class="lang-en">Projects</span></em>
  </h2>
  <div class="projects-grid">
    {visibleProjects.map((project, index) => (
      <ProjectCard project={project} repeated={index >= projects.length} />
    ))}
  </div>
  <p class="mobile-hint">
    <span class="lang-es">Tocá un proyecto para conocerlo</span>
    <span class="lang-en">Tap a project to learn more</span>
  </p>
</section>

<ProjectModal projects={projects} />
