---
import { t } from 'i18next';
import { academicExperience, courses, workExperience } from '../data/experience';

const hasCertificates = courses.some((course) => Boolean(course.certificateImage));
const experienceKey = (group: string, id: string, field: string) => `experience.items.${group}.${id}.${field}`;
---

<section id="experiencia" class="panel section-block experience-section" aria-labelledby="experience-title" data-reveal-section data-certificate-viewer>
  <h2 id="experience-title">{t('experience.titlePrefix')} <em>{t('experience.titleAccent')}</em></h2>
  <p>{t('experience.copy')}</p>

  <div class="experience-content">
    <section class="experience-group" aria-labelledby="work-experience-title">
      <header class="experience-group__heading">
        <p class="experience-kicker" aria-hidden="true">01</p>
        <h3 id="work-experience-title">{t('experience.work')}</h3>
      </header>

      <div class="experience-grid experience-grid--work">
        {workExperience.map((item) => (
          <article class="experience-card experience-card--work">
            <div class="experience-card__identity">
              <p class="experience-period">
                <span class="dot" aria-hidden="true">●</span>
                {item.startYear} · {item.current ? t('experience.current') : item.endYear}
              </p>
              <h4>{t(experienceKey('work', item.id, 'role'))}</h4>
              <p class="experience-source">{t(experienceKey('work', item.id, 'company'))}</p>
              {item.hasDescription && <p class="experience-description">{t(experienceKey('work', item.id, 'description'))}</p>}
            </div>

            <div class="experience-card__skills">
              <p class="experience-label">{t('experience.skills')}</p>
              <ul class="experience-skills">
                {item.skillIds.map((skillId) => <li>{t(experienceKey('work', item.id, `skills.${skillId}`))}</li>)}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </section>

    <aside class="experience-bridge">
      <span class="experience-bridge__quote experience-bridge__quote--open" aria-hidden="true">“</span>
      <p>
        {t('experience.bridge.beforeFirst')}<strong class="experience-bridge__emphasis">{t('experience.bridge.first')}</strong>{t('experience.bridge.betweenFirstSecond')}<strong class="experience-bridge__emphasis">{t('experience.bridge.second')}</strong>{t('experience.bridge.betweenSecondThird')}<strong class="experience-bridge__emphasis">{t('experience.bridge.third')}</strong>{t('experience.bridge.afterThird')}
      </p>
      <span class="experience-bridge__quote experience-bridge__quote--close" aria-hidden="true">”</span>
    </aside>

    <section class="experience-group" aria-labelledby="courses-title">
      <header class="experience-group__heading">
        <p class="experience-kicker" aria-hidden="true">02</p>
        <h3 id="courses-title">{t('experience.courses')}</h3>
      </header>

      <div class="experience-grid">
        {courses.map((course) => {
          const title = t(experienceKey('courses', course.id, 'title'));
          return (
            <article class="experience-card experience-card--course">
              <p class="experience-period"><span class="dot" aria-hidden="true">●</span>{course.durationHours} {t('experience.hours')}</p>
              <h4>{title}</h4>
              <div class="course-card__footer">
                <p class="experience-source">{t(experienceKey('courses', course.id, 'institution'))}</p>
                {course.certificateImage && (
                  <button
                    class="certificate-button"
                    type="button"
                    data-certificate-open
                    data-certificate-src={course.certificateImage}
                    data-certificate-alt={t(experienceKey('courses', course.id, 'certificateAlt'))}
                    data-certificate-title={title}
                  >
                    <span class="certificate-button__label">{t('experience.certificate')}</span>
                    <span class="certificate-button__icon" aria-hidden="true"></span>
                  </button>
                )}
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <section class="experience-group" aria-labelledby="academic-title">
      <header class="experience-group__heading">
        <p class="experience-kicker" aria-hidden="true">03</p>
        <h3 id="academic-title">{t('experience.academic')}</h3>
      </header>

      <div class="experience-grid">
        {academicExperience.map((item) => (
          <article class="experience-card">
            <p class="experience-period"><span class="dot" aria-hidden="true">●</span>{item.startYear} · {item.endYear}</p>
            <h4>{t(experienceKey('academic', item.id, 'title'))}</h4>
            <p class="experience-source">{t(experienceKey('academic', item.id, 'institution'))}</p>
            <p class="experience-description">{t(experienceKey('academic', item.id, 'description'))}</p>
          </article>
        ))}
      </div>
    </section>
  </div>

  {hasCertificates && (
    <dialog class="project-lightbox certificate-lightbox" aria-label={t('experience.certificate')} data-certificate-dialog>
      <button class="project-lightbox__close" type="button" aria-label={t('actions.closeCertificate')} data-certificate-close>
        <span aria-hidden="true"></span>
      </button>
      <figure class="project-lightbox__figure certificate-lightbox__figure">
        <img alt="" data-certificate-image />
        <figcaption data-certificate-caption></figcaption>
      </figure>
    </dialog>
  )}
</section>

<script>
  import '../scripts/certificate-viewer';
</script>