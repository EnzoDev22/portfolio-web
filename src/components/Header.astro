<header class="site-header" aria-label="Navegación principal">
  <a class="logo" href="#inicio" aria-label="Ir al inicio">E N Z O</a>

  <div class="desktop-nav-slot">
    <nav class="desktop-nav" aria-label="Secciones del portfolio">
      <a href="#inicio"><span class="lang-es">Inicio</span><span class="lang-en">Home</span></a>
      <a href="#proyectos"><span class="lang-es">Proyectos</span><span class="lang-en">Projects</span></a>
      <a href="#habilidades"><span class="lang-es">Habilidades</span><span class="lang-en">Skills</span></a>
      <a href="#formacion"><span class="lang-es">Formación</span><span class="lang-en">Education</span></a>
      <a href="#contacto"><span class="lang-es">Contacto</span><span class="lang-en">Contact</span></a>
    </nav>
  </div>

  <div class="header-controls">
    <button class="language-toggle" type="button" aria-label="Cambiar idioma" aria-pressed="false">
      <span aria-hidden="true">ES</span>
    </button>
    <button class="round-control theme-toggle" type="button" aria-label="Activar tema oscuro" aria-pressed="false">
      <span class="theme-icon" aria-hidden="true">
        <img class="theme-icon-light" src="/assets/theme-light.svg" width="22" height="22" alt="" />
        <img class="theme-icon-dark" src="/assets/theme-dark.svg" width="18" height="18" alt="" />
      </span>
    </button>
    <button class="round-control menu-toggle" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu">
      <span aria-hidden="true">☰</span>
    </button>
  </div>

  <nav id="mobile-menu" class="mobile-nav" aria-label="Navegación mobile" hidden>
    <a href="#inicio"><span class="lang-es">Inicio</span><span class="lang-en">Home</span></a>
    <a href="#proyectos"><span class="lang-es">Proyectos</span><span class="lang-en">Projects</span></a>
    <a href="#habilidades"><span class="lang-es">Habilidades</span><span class="lang-en">Skills</span></a>
    <a href="#formacion"><span class="lang-es">Formación</span><span class="lang-en">Education</span></a>
    <a href="#contacto"><span class="lang-es">Contacto</span><span class="lang-en">Contact</span></a>
  </nav>
</header>

<script>
  const desktopNavSlot = document.querySelector<HTMLElement>('.desktop-nav-slot');
  const desktopNav = desktopNavSlot?.querySelector<HTMLElement>('.desktop-nav');
  const desktopMedia = matchMedia('(min-width: 900px)');
  const scrollspyItems = Array.from(desktopNav?.querySelectorAll<HTMLAnchorElement>('a[href^="#"]') ?? []).flatMap((link) => {
    const section = document.querySelector<HTMLElement>(link.hash);
    return section ? [{ link, section }] : [];
  });
  let navbarFrame = 0;
  let scrollspyFrame = 0;
  let scrollspyObserver: IntersectionObserver | null = null;

  function syncDesktopNavbarBlur() {
    desktopNav?.classList.toggle('is-scrolled', desktopMedia.matches && window.scrollY > 0);
  }

  function positionDesktopNavbar() {
    if (!desktopNavSlot || !desktopNav) return;

    desktopNav.classList.remove('is-fixed');
    desktopNav.style.removeProperty('left');
    desktopNav.style.removeProperty('top');
    desktopNav.style.removeProperty('width');
    desktopNavSlot.style.removeProperty('width');
    desktopNavSlot.style.removeProperty('height');

    if (!desktopMedia.matches) {
      syncDesktopNavbarBlur();
      return;
    }

    const navbarBounds = desktopNav.getBoundingClientRect();
    const navbarTop = navbarBounds.top + window.scrollY;
    desktopNavSlot.style.width = `${navbarBounds.width}px`;
    desktopNavSlot.style.height = `${navbarBounds.height}px`;
    desktopNav.style.left = `${desktopNavSlot.getBoundingClientRect().left}px`;
    desktopNav.style.top = `${navbarTop}px`;
    desktopNav.style.width = `${navbarBounds.width}px`;
    desktopNav.classList.add('is-fixed');
    syncDesktopNavbarBlur();
  }

  function scheduleNavbarPosition() {
    cancelAnimationFrame(navbarFrame);
    navbarFrame = requestAnimationFrame(positionDesktopNavbar);
  }

  function setActiveSection(sectionId: string | null) {
    scrollspyItems.forEach(({ link, section }) => {
      const isActive = section.id === sectionId;
      link.classList.toggle('is-active', isActive);
      if (isActive) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    });
  }

  function updateActiveSection() {
    if (!desktopMedia.matches || !scrollspyItems.length) return;

    if (window.scrollY <= 1) {
      setActiveSection(scrollspyItems[0].section.id);
      return;
    }

    const pageBottom = Math.ceil(window.scrollY + window.innerHeight);
    if (pageBottom >= document.documentElement.scrollHeight - 1) {
      setActiveSection(scrollspyItems.at(-1)?.section.id ?? null);
      return;
    }

    const navbarBottom = desktopNav?.getBoundingClientRect().bottom ?? 0;
    const activationPoint = Math.max(navbarBottom + 24, window.innerHeight * .32);
    let activeSection = scrollspyItems[0].section;

    for (const { section } of scrollspyItems) {
      const bounds = section.getBoundingClientRect();
      if (bounds.top <= activationPoint) activeSection = section;
      if (bounds.top <= activationPoint && bounds.bottom > activationPoint) break;
    }

    setActiveSection(activeSection.id);
  }

  function stopScrollspy(clearActiveState = true) {
    scrollspyObserver?.disconnect();
    scrollspyObserver = null;
    if (clearActiveState) setActiveSection(null);
  }

  function startScrollspy() {
    stopScrollspy(false);
    if (!desktopMedia.matches || !desktopNav || !scrollspyItems.length) return;

    const navbarBottom = Math.ceil(desktopNav.getBoundingClientRect().bottom);
    const activationPoint = Math.min(
      window.innerHeight - 1,
      Math.max(navbarBottom + 24, Math.round(window.innerHeight * .32)),
    );
    const bottomMargin = Math.max(0, window.innerHeight - activationPoint - 1);

    scrollspyObserver = new IntersectionObserver(updateActiveSection, {
      rootMargin: `-${activationPoint}px 0px -${bottomMargin}px 0px`,
      threshold: 0,
    });
    scrollspyItems.forEach(({ section }) => scrollspyObserver?.observe(section));
    updateActiveSection();
  }

  function scheduleScrollspy() {
    cancelAnimationFrame(scrollspyFrame);
    scrollspyFrame = requestAnimationFrame(() => {
      if (desktopMedia.matches) startScrollspy();
      else stopScrollspy();
    });
  }

  function syncDesktopHeader() {
    scheduleNavbarPosition();
    scheduleScrollspy();
  }

  desktopMedia.addEventListener('change', syncDesktopHeader);
  window.addEventListener('resize', syncDesktopHeader, { passive: true });
  window.addEventListener('scroll', syncDesktopNavbarBlur, { passive: true });
  new MutationObserver(scheduleNavbarPosition).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-lang'],
  });
  syncDesktopHeader();
</script>
