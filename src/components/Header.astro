---
interface Props {
  sectionPrefix?: string;
  activeSection?: string;
  locale: 'es' | 'en';
}

import { t } from 'i18next';
const { sectionPrefix = '', activeSection, locale } = Astro.props;
const sectionHref = (section: string) => `${sectionPrefix}#${section}`;
const desktopNavLinkClass = 'flex min-h-10 items-center rounded-full px-3.5 py-2 !text-[color:var(--muted)] text-[.78rem] font-semibold transition-[background-color,color] duration-[180ms] ease-[ease] hover:!bg-[var(--surface)] hover:!text-[color:var(--text)] focus-visible:!bg-[var(--surface)] focus-visible:!text-[color:var(--text)] [&.is-active]:!bg-[var(--accent)] [&.is-active]:!text-[color:var(--accent-ink)]';
const mobileNavLinkClass = 'flex min-h-[46px] items-center rounded-full px-3.5 text-[.9rem] font-semibold hover:bg-[var(--surface-soft)] focus-visible:bg-[var(--surface-soft)] supports-[background:color-mix(in_srgb,white_50%,black)]:hover:bg-[color-mix(in_srgb,var(--accent)_22%,var(--surface))] supports-[background:color-mix(in_srgb,white_50%,black)]:focus-visible:bg-[color-mix(in_srgb,var(--accent)_22%,var(--surface))]';
---

<header class="site-header relative z-20 mx-auto flex min-h-[76px] w-[min(calc(100%_-_(var(--content-padding)_*_2)),var(--content-max-width))] items-center justify-between gap-3.5 border-[color:var(--line)] py-3 max-[639px]:sticky max-[639px]:top-0 max-[639px]:bg-[var(--page)] min-[900px]:fixed min-[900px]:inset-x-0 min-[900px]:z-30 min-[900px]:min-h-[104px] min-[900px]:w-full min-[900px]:border-b-transparent min-[900px]:bg-transparent min-[900px]:px-[max(var(--content-padding),calc((100%_-_var(--content-max-width))_/_2))] min-[900px]:py-6 min-[900px]:transition-[min-height,padding,background-color,border-color,box-shadow,backdrop-filter] min-[900px]:duration-[280ms] min-[900px]:ease-[ease] motion-reduce:!transition-none min-[900px]:[&.is-scrolled]:min-h-[76px] min-[900px]:[&.is-scrolled]:border-b-[color:var(--line)] min-[900px]:[&.is-scrolled]:bg-[var(--page)] min-[900px]:[&.is-scrolled]:py-3 min-[900px]:[&.is-scrolled]:shadow-[var(--shadow)] min-[900px]:[&.is-scrolled]:backdrop-blur-[12px] min-[900px]:[&.is-scrolled]:supports-[background:color-mix(in_srgb,white_50%,black)]:bg-[color-mix(in_srgb,var(--page)_88%,transparent)]" aria-label={t('nav.label')}>
  <a class="inline-flex min-h-11 items-center whitespace-nowrap text-[length:clamp(.75rem,3.5vw,.92rem)] font-extrabold tracking-[length:clamp(.18em,.9vw,.28em)] min-[900px]:text-[1rem]" href={sectionHref('inicio')} aria-label={t('nav.home')}>E N Z O <span class="text-[color:var(--accent)]">.D E V</span></a>

  <div class="desktop-nav-slot hidden min-[900px]:block min-[900px]:flex-none">
    <nav class="desktop-nav hidden items-center gap-0.5 rounded-full border border-solid border-[color:var(--line)] bg-[var(--page)] p-[5px] supports-[background:color-mix(in_srgb,white_50%,black)]:bg-[color-mix(in_srgb,var(--page)_92%,transparent)] min-[900px]:flex" aria-label={t('nav.label')}>
      <a class={desktopNavLinkClass} href={sectionHref('inicio')}>{t('nav.home')}</a><a class:list={[desktopNavLinkClass, { 'is-active': activeSection === 'proyectos' }]} href={sectionHref('proyectos')} aria-current={activeSection === 'proyectos' ? 'page' : undefined}>{t('nav.projects')}</a><a class={desktopNavLinkClass} href={sectionHref('habilidades')}>{t('nav.skills')}</a><a class={desktopNavLinkClass} href={sectionHref('experiencia')}>{t('nav.experience')}</a><a class={desktopNavLinkClass} href={sectionHref('contacto')}>{t('nav.contact')}</a>
    </nav>
  </div>

  <div class="flex items-center gap-2">
    <div class="persistent-controls-slot flex flex-none items-center">
      <div class="persistent-header-controls flex items-center gap-2 [&.is-fixed]:fixed [&.is-fixed]:z-30">
        <a class="language-toggle relative flex min-h-11 min-w-11 w-12 items-center justify-center overflow-hidden rounded-full border border-solid border-[color:var(--line)] bg-[var(--surface)] p-0 text-[.68rem] font-bold tracking-[.08em] text-[color:var(--text)] transition-[border-color,background-color,transform] duration-[180ms] ease-[ease] hover:-translate-y-px hover:border-[color:var(--accent-strong)] hover:bg-[var(--surface-soft)] focus-visible:-translate-y-px focus-visible:border-[color:var(--accent-strong)] focus-visible:bg-[var(--surface-soft)] after:absolute after:right-2 after:bottom-1.5 after:left-2 after:h-0.5 after:rounded-[2px] after:bg-[var(--accent)] after:content-[''] after:scale-x-[.45] after:transition-transform after:duration-[180ms] after:ease-[ease]" href={locale === 'en' ? '/' : '/en/'} aria-label={t('actions.language')}><span aria-hidden="true">{locale === 'en' ? 'EN' : 'ES'}</span></a>
        <button class="theme-toggle flex h-11 w-11 min-h-11 min-w-11 items-center justify-center rounded-full border border-solid border-[color:var(--line)] bg-[var(--surface)] p-0 text-[color:var(--text)] transition-[border-color,background-color,transform] duration-[180ms] ease-[ease] hover:-translate-y-px hover:border-[color:var(--accent-strong)] hover:bg-[var(--surface-soft)] focus-visible:-translate-y-px focus-visible:border-[color:var(--accent-strong)] focus-visible:bg-[var(--surface-soft)] dark:[&_.theme-icon-light]:!hidden dark:[&_.theme-icon-dark]:!block" type="button" aria-label={t('actions.darkTheme')} data-light-label={t('actions.lightTheme')} data-dark-label={t('actions.darkTheme')} aria-pressed="false">
          <span class="flex h-[22px] w-[22px] items-center justify-center" aria-hidden="true">
            <img class="theme-icon-light" src="/assets/theme-light.svg" width="22" height="22" alt="" />
            <img class="theme-icon-dark !hidden" src="/assets/theme-dark.svg" width="18" height="18" alt="" />
          </span>
        </button>
      </div>
    </div>
    <button class="menu-toggle flex h-11 w-11 min-h-11 min-w-11 items-center justify-center rounded-full border border-solid border-[color:var(--line)] bg-[var(--surface)] p-0 text-[1.28rem] text-[color:var(--text)] transition-[border-color,background-color,transform] duration-[180ms] ease-[ease] hover:-translate-y-px hover:border-[color:var(--accent-strong)] hover:bg-[var(--surface-soft)] focus-visible:-translate-y-px focus-visible:border-[color:var(--accent-strong)] focus-visible:bg-[var(--surface-soft)] min-[900px]:hidden" type="button" aria-label={t('actions.openMenu')} data-open-label={t('actions.openMenu')} data-close-label={t('actions.closeMenu')} aria-expanded="false" aria-controls="mobile-menu">
      <span aria-hidden="true">☰</span>
    </button>
  </div>

  <nav id="mobile-menu" class="mobile-nav fixed z-[35] top-[68px] right-4 flex w-[min(256px,calc(100vw_-_32px))] flex-col rounded-[var(--radius-md)] border border-solid border-[color:var(--line)] bg-[var(--surface)] p-2 shadow-[var(--shadow-raised)] backdrop-blur-[14px] supports-[background:color-mix(in_srgb,white_50%,black)]:bg-[color-mix(in_srgb,var(--surface)_96%,transparent)]" aria-label={t('nav.label')} hidden>
    <a class={mobileNavLinkClass} href={sectionHref('inicio')}>{t('nav.home')}</a><a class={mobileNavLinkClass} href={sectionHref('proyectos')}>{t('nav.projects')}</a><a class={mobileNavLinkClass} href={sectionHref('habilidades')}>{t('nav.skills')}</a><a class={mobileNavLinkClass} href={sectionHref('experiencia')}>{t('nav.experience')}</a><a class={mobileNavLinkClass} href={sectionHref('contacto')}>{t('nav.contact')}</a>
  </nav>
</header>
<script>
  const siteHeader = document.querySelector<HTMLElement>('.site-header');
  const desktopNavSlot = document.querySelector<HTMLElement>('.desktop-nav-slot');
  const desktopNav = desktopNavSlot?.querySelector<HTMLElement>('.desktop-nav');
  const persistentControlsSlot = document.querySelector<HTMLElement>('.persistent-controls-slot');
  const persistentControls = persistentControlsSlot?.querySelector<HTMLElement>('.persistent-header-controls');
  const persistentControlsMedia = matchMedia('(min-width: 640px)');
  const desktopMedia = matchMedia('(min-width: 900px)');
  const scrollspyItems = Array.from(desktopNav?.querySelectorAll<HTMLAnchorElement>('a[href^="#"]') ?? []).flatMap((link) => {
    const section = document.querySelector<HTMLElement>(link.hash);
    return section ? [{ link, section }] : [];
  });
  let headerFrame = 0;
  let controlsFrame = 0;
  let scrollspyFrame = 0;
  let scrollspyObserver: IntersectionObserver | null = null;
  let desktopHeaderInitialized = false;

  function syncHeaderScrollState() {
    if (headerFrame) return;
    headerFrame = requestAnimationFrame(() => {
      headerFrame = 0;
      siteHeader?.classList.toggle('is-scrolled', desktopMedia.matches && window.scrollY > 16);
    });
  }

  function positionPersistentControls() {
    if (!persistentControlsSlot || !persistentControls) return;

    persistentControls.classList.remove('is-fixed');
    persistentControls.style.removeProperty('left');
    persistentControls.style.removeProperty('top');
    persistentControls.style.removeProperty('width');
    persistentControlsSlot.style.removeProperty('width');
    persistentControlsSlot.style.removeProperty('height');

    if (!persistentControlsMedia.matches || desktopMedia.matches) return;

    const controlsBounds = persistentControls.getBoundingClientRect();
    const controlsTop = controlsBounds.top + window.scrollY;
    persistentControlsSlot.style.width = `${controlsBounds.width}px`;
    persistentControlsSlot.style.height = `${controlsBounds.height}px`;
    persistentControls.style.left = `${persistentControlsSlot.getBoundingClientRect().left}px`;
    persistentControls.style.top = `${controlsTop}px`;
    persistentControls.style.width = `${controlsBounds.width}px`;
    persistentControls.classList.add('is-fixed');
  }

  function schedulePersistentControlsPosition() {
    cancelAnimationFrame(controlsFrame);
    controlsFrame = requestAnimationFrame(positionPersistentControls);
  }

  function setActiveSection(sectionId: string | null) {
    scrollspyItems.forEach(({ link, section }) => {
      const isActive = section.id === sectionId;
      link.classList.toggle('is-active', isActive);
      if (isActive) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    });
  }

  function updateActiveSection() {
    if (!desktopMedia.matches || !scrollspyItems.length) return;

    if (window.scrollY <= 1) {
      setActiveSection(scrollspyItems[0].section.id);
      return;
    }

    const pageBottom = Math.ceil(window.scrollY + window.innerHeight);
    if (pageBottom >= document.documentElement.scrollHeight - 1) {
      setActiveSection(scrollspyItems.at(-1)?.section.id ?? null);
      return;
    }

    const navbarBottom = desktopNav?.getBoundingClientRect().bottom ?? 0;
    const activationPoint = Math.max(navbarBottom + 24, window.innerHeight * .32);
    let activeSection = scrollspyItems[0].section;

    for (const { section } of scrollspyItems) {
      const bounds = section.getBoundingClientRect();
      if (bounds.top <= activationPoint) activeSection = section;
      if (bounds.top <= activationPoint && bounds.bottom > activationPoint) break;
    }

    setActiveSection(activeSection.id);
  }

  function stopScrollspy(clearActiveState = true) {
    scrollspyObserver?.disconnect();
    scrollspyObserver = null;
    if (clearActiveState) setActiveSection(null);
  }

  function startScrollspy() {
    stopScrollspy(false);
    if (!desktopMedia.matches || !desktopNav || !scrollspyItems.length) return;

    const navbarBottom = Math.ceil(desktopNav.getBoundingClientRect().bottom);
    const activationPoint = Math.min(
      window.innerHeight - 1,
      Math.max(navbarBottom + 24, Math.round(window.innerHeight * .32)),
    );
    const bottomMargin = Math.max(0, window.innerHeight - activationPoint - 1);

    scrollspyObserver = new IntersectionObserver(updateActiveSection, {
      rootMargin: `-${activationPoint}px 0px -${bottomMargin}px 0px`,
      threshold: 0,
    });
    scrollspyItems.forEach(({ section }) => scrollspyObserver?.observe(section));
    updateActiveSection();
  }

  function scheduleScrollspy() {
    cancelAnimationFrame(scrollspyFrame);
    scrollspyFrame = requestAnimationFrame(() => {
      if (desktopMedia.matches) startScrollspy();
      else stopScrollspy();
    });
  }

  function syncDesktopHeader() {
    syncHeaderScrollState();
    schedulePersistentControlsPosition();
    scheduleScrollspy();
  }

  async function initializeDesktopHeader() {
    if (desktopHeaderInitialized) return;
    desktopHeaderInitialized = true;

    if ('fonts' in document) await document.fonts.ready;

    desktopMedia.addEventListener('change', syncDesktopHeader);
    persistentControlsMedia.addEventListener('change', syncDesktopHeader);
    window.addEventListener('resize', syncDesktopHeader, { passive: true });
    window.addEventListener('scroll', syncHeaderScrollState, { passive: true });
    syncDesktopHeader();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeDesktopHeader, { once: true });
  } else {
    initializeDesktopHeader();
  }
</script>
