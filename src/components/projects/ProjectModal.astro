---
import type { Project } from '../../data/projects';
import ProjectGallery from './ProjectGallery.astro';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
const initialProject = projects[0];
const serializedProjects = JSON.stringify(projects).replace(/</g, '\\u003c');
---

<dialog
  id="project-modal"
  class="project-modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="project-modal-title"
  aria-describedby="project-modal-description"
  data-state="closed"
>
  <div class="project-modal__surface">
    <header class="project-modal__header">
      <p class="project-modal__eyebrow">PROYECTO DESTACADO</p>
      <button class="modal-close" type="button" aria-label="Cerrar modal" data-modal-close>
        <span aria-hidden="true"></span>
      </button>
    </header>

    <div class="project-modal__layout">
      <ProjectGallery images={initialProject.images} alt={initialProject.alt} />

      <div class="project-modal__info">
        <h2 id="project-modal-title">
          <span class="lang-es" data-modal-title-es>{initialProject.title}</span>
          <span class="lang-en" data-modal-title-en>{initialProject.titleEn}</span>
        </h2>

        <p id="project-modal-description">
          <span class="lang-es" data-modal-description-es>{initialProject.description}</span>
          <span class="lang-en" data-modal-description-en>{initialProject.descriptionEn}</span>
        </p>

        <p class="project-modal__technologies-label">TECNOLOGÍAS</p>

        <ul class="project-modal__technologies" data-modal-technologies>
          {initialProject.technologies.map((item) => (
            <li aria-label={item.name} title={item.name}>
              <span class="project-technology-icon" style={`--project-technology-icon: url("${item.icon}")`} aria-hidden="true"></span>
            </li>
          ))}
        </ul>

        <div class="project-modal__actions">
          <a class="modal-github" href={initialProject.githubUrl} target="_blank" rel="noreferrer" aria-label={`Ver ${initialProject.title} en GitHub`} data-modal-github>
            <span aria-hidden="true"></span>
          </a>
          <a class="modal-project-link" href={initialProject.projectUrl} target="_blank" rel="noreferrer" data-modal-project>
            <span class="lang-es">Ver proyecto</span>
            <span class="lang-en">View project</span>
            <span class="modal-project-link__arrow" aria-hidden="true"></span>
          </a>
        </div>
      </div>
    </div>
  </div>
</dialog>

<script is:inline type="application/json" data-project-modal-data set:html={serializedProjects}></script>

<script>
  import '../../scripts/project-modal';
</script>
