---
import type { Project } from '../../data/projects';
import ProjectGallery from './ProjectGallery.astro';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
const initialProject = projects[0];
const serializedProjects = JSON.stringify(projects).replace(/</g, '\\u003c');
---

<dialog
  id="project-modal"
  class="project-modal m-auto max-h-none max-w-none border-0 bg-transparent p-0 text-[var(--text)]"
  role="dialog"
  aria-modal="true"
  aria-labelledby="project-modal-title"
  aria-describedby="project-modal-description"
  data-state="closed"
>
  <div class="project-modal__surface h-[min(700px,calc(100svh-32px))] w-[min(358px,calc(100vw-32px))] overflow-x-hidden overflow-y-auto rounded-[28px] bg-[var(--modal-bg)] p-5 shadow-[0_18px_30px_rgba(0,0,0,0.28)] min-[900px]:h-[min(640px,calc(100vh-64px))] min-[900px]:w-[min(1050px,calc(100vw-64px))] min-[900px]:rounded-[36px] min-[900px]:p-10">
    <div class="project-modal__layout flex min-w-0 flex-col gap-3 min-[900px]:grid min-[900px]:grid-cols-[430px_minmax(0,504px)] min-[900px]:items-start min-[900px]:gap-9">
      <ProjectGallery images={initialProject.images} alt={initialProject.alt} />

      <div class="project-modal__info contents min-[900px]:flex min-[900px]:h-[560px] min-[900px]:min-w-0 min-[900px]:flex-col min-[900px]:items-start min-[900px]:gap-4">
        <header class="order-1 flex h-10 w-full items-center justify-between min-[900px]:h-12">
          <p class="m-0 text-sm font-bold text-[var(--accent)]">PROYECTO DESTACADO</p>
          <button class="modal-close grid size-10 shrink-0 place-items-center rounded-[14px] border-0 bg-[var(--modal-control-bg)] text-[var(--modal-control-text)] min-[900px]:size-11" type="button" aria-label="Cerrar modal" data-modal-close>
            <span aria-hidden="true"></span>
          </button>
        </header>

        <h2 id="project-modal-title" class="order-2 m-0 w-full text-[26px] leading-[34px] font-bold text-[var(--modal-title)] min-[900px]:text-[38px] min-[900px]:leading-[46px]">
          <span class="lang-es" data-modal-title-es>{initialProject.title}</span>
          <span class="lang-en" data-modal-title-en>{initialProject.titleEn}</span>
        </h2>

        <p id="project-modal-description" class="order-3 m-0 w-full text-base leading-[23px] text-[var(--modal-copy)] min-[900px]:min-h-[92px] min-[900px]:text-lg min-[900px]:leading-[27px]">
          <span class="lang-es" data-modal-description-es>{initialProject.description}</span>
          <span class="lang-en" data-modal-description-en>{initialProject.descriptionEn}</span>
        </p>

        <p class="order-6 m-0 w-full text-[13px] font-bold text-[var(--modal-title)] min-[900px]:text-sm">TECNOLOGÍAS</p>

        <ul class="project-modal__technologies order-7 m-0 flex h-[42px] w-full list-none items-center gap-2.5 overflow-hidden p-0 min-[900px]:h-[54px] min-[900px]:gap-3" data-modal-technologies>
          {initialProject.technologies.map((item) => (
            <li class="grid size-10 shrink-0 place-items-center min-[900px]:size-[50px]">
              <img class="size-full object-contain" src={item.icon} alt={item.name} title={item.name} />
            </li>
          ))}
        </ul>

        <div class="project-modal__actions order-8 flex h-[52px] w-full min-w-0 items-center gap-3 min-[900px]:h-[78px] min-[900px]:gap-3.5 min-[900px]:py-2.5">
          <a class="modal-github grid size-[52px] shrink-0 place-items-center rounded-[15px] bg-[#171717] text-[#d9d9d9] min-[900px]:h-[54px] min-[900px]:w-[57px]" href={initialProject.githubUrl} target="_blank" rel="noreferrer" aria-label={`Ver ${initialProject.title} en GitHub`} data-modal-github>
            <span aria-hidden="true"></span>
          </a>
          <a class="modal-project-link flex h-[52px] min-w-0 flex-1 items-center justify-center gap-5 overflow-hidden rounded-[17px] bg-[var(--accent)] px-4 text-[15px] font-bold whitespace-nowrap text-[var(--modal-button-text)] min-[900px]:h-[58px] min-[900px]:w-[220px] min-[900px]:flex-none min-[900px]:text-[17px]" href={initialProject.projectUrl} target="_blank" rel="noreferrer" data-modal-project>
            <span class="lang-es">Ver proyecto</span>
            <span class="lang-en">View project</span>
            <span class="modal-project-link__arrow" aria-hidden="true"></span>
          </a>
        </div>
      </div>
    </div>
  </div>
</dialog>

<script is:inline type="application/json" data-project-modal-data set:html={serializedProjects}></script>

<script>
  import '../../scripts/project-modal';
</script>
