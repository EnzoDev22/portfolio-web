---
import type { Project } from '../../data/projects';
import { Image } from 'astro:assets';
import { t } from 'i18next';

interface Props {
  project: Project;
  locale: 'es' | 'en';
}

const { project, locale } = Astro.props;
const projectKey = (field: string) => `projects.items.${project.id}.${field}`;
const title = t(projectKey('title'));
---

<article class="project-card">
  <div class="project-card__media">
    <Image src={project.image} alt={t(projectKey('alt'))} layout="full-width" loading="lazy" decoding="async" />
  </div>

  <div class="project-card__body">
    <h3>
      <a class="open-project" href={`${locale === 'en' ? '/en' : ''}/proyectos/${project.id}/`} aria-label={`${t('actions.viewProject')}: ${title}`}>
        {title}
      </a>
    </h3>

    {project.inProduction && <p class="project-card__status">{t('projects.production')}</p>}
    <p class="project-card__subtitle">{t(projectKey('subtitle'))}</p>
    <p class="project-card__description">{t(projectKey('description'))}</p>

    <a class="project-card__github" href={project.githubUrl} target="_blank" rel="noreferrer" aria-label={`GitHub: ${title}`}>
      <span class="project-card__github-icon" aria-hidden="true"></span>
      GitHub
    </a>

    <ul class="project-card__technologies" aria-label={t('actions.technologies')}>
      {project.technologies.map((technology) => <li>{technology.name}</li>)}
    </ul>

    <span class="project-card__cta" aria-hidden="true">
      {t('actions.viewProject')}
      <span class="project-card__arrow">→</span>
    </span>
  </div>
</article>