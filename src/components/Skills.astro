---
import { t } from 'i18next';
import { skills } from '../data/portfolio';

const rail = [...skills, ...skills];
---

<section id="habilidades" class="panel section-block skills-section" aria-labelledby="skills-title" data-reveal-section>
  <h2 id="skills-title">{t('skills.titlePrefix')} <em>{t('skills.titleAccent')}</em></h2>
  <p>{t('skills.copy')}</p>
  <div class="skills-viewport" aria-label={t('skills.label')}>
    <div class="skills-rail">
      {rail.map(([name, icon], index) => (
        <div class="skill-card" aria-hidden={index >= skills.length ? 'true' : undefined}>
          <span class="skill-icon" style={`--skill-icon: url("${icon}")`} aria-hidden="true"></span>
          <span class="skill-name">{name}</span>
        </div>
      ))}
    </div>
  </div>
</section>