<section id="contacto" class="panel section-block contact-section" aria-labelledby="contact-title">
  <h2 id="contact-title"><span class="lang-es">Hablemos</span><span class="lang-en">Let's talk</span></h2>
  <p class="contact-lead"><span class="lang-es">¿Tenés una idea o una oportunidad? Me encantaría conocerla.</span><span class="lang-en">Have an idea or an opportunity? I would love to hear about it.</span></p>
  <div class="contact-grid">
    <aside class="contact-info">
      <div class="contact-orbit" aria-hidden="true"><span></span></div>
      <h3><span class="lang-es">Construyamos algo<br /><strong>juntos.</strong></span><span class="lang-en">Let's build something<br /><strong>together.</strong></span></h3>
      <p><span class="lang-es">Disponible para oportunidades,<br />colaboraciones y nuevos desafíos.</span><span class="lang-en">Available for opportunities,<br />collaborations, and new challenges.</span></p>
      <a class="email-pill" href="mailto:tu-email@dominio.com">tu-email@dominio.com</a>
      <div class="social-links">
        <a class="linkedin" href="https://www.linkedin.com/" rel="noreferrer" target="_blank">LinkedIn</a>
        <a class="github" href="https://github.com/" rel="noreferrer" target="_blank">GitHub</a>
      </div>
      <small>● Buenos Aires · Argentina</small>
    </aside>

    <form class="contact-form">
      <h3><span class="lang-es">Contame sobre tu idea</span><span class="lang-en">Tell me about your idea</span></h3>
      <div class="form-row">
        <label><span><span class="lang-es">NOMBRE</span><span class="lang-en">NAME</span></span><input name="name" autocomplete="name" placeholder="Tu nombre" required /></label>
        <label><span>EMAIL</span><input name="email" type="email" autocomplete="email" placeholder="tu@email.com" required /></label>
      </div>
      <label><span><span class="lang-es">ASUNTO</span><span class="lang-en">SUBJECT</span></span><input name="subject" placeholder="¿En qué podemos trabajar?" required /></label>
      <label><span><span class="lang-es">MENSAJE</span><span class="lang-en">MESSAGE</span></span><textarea name="message" placeholder="Contame un poco más..." required></textarea></label>
      <button type="submit"><span class="lang-es">Enviar mensaje</span><span class="lang-en">Send message</span></button>
    </form>
  </div>
</section>
