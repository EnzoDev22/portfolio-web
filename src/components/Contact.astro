---
import { t } from 'i18next';
---

<section id="contacto" class="panel section-block contact-section" aria-labelledby="contact-title" data-reveal-section>
  <div class="contact-grid">
    <aside class="contact-info">
      <p class="contact-kicker"><span class="contact-kicker-dot" aria-hidden="true"></span>{t('contact.kicker')}</p>
      <h2 id="contact-title">{t('contact.titleStart')}<em>{t('contact.titleAccent')}</em>{t('contact.titleEnd')}</h2>
      <p class="contact-copy">{t('contact.copy')}</p>

      <div class="social-links">
        <a class="linkedin" href="https://linkedin.com/in/enzo-jesuan-del-sole" rel="noreferrer" target="_blank">LinkedIn</a>
        <a class="github" href="https://github.com/EnzoDev22" rel="noreferrer" target="_blank">GitHub</a>
      </div>
    </aside>

    <form
      class="contact-form"
      action="/api/contact"
      method="post"
      novalidate
      data-button={t('contact.send')}
      data-sending={t('contact.form.sending')}
      data-success={t('contact.form.success')}
      data-validation={t('contact.form.validation')}
      data-server={t('contact.form.server')}
      data-required={t('contact.form.required')}
      data-error-name={t('contact.form.name')}
      data-error-email={t('contact.form.email')}
      data-error-subject={t('contact.form.subject')}
      data-error-message={t('contact.form.message')}
    >
      <div class="contact-form-heading">
        <p>{t('contact.write')}</p>
        <h3>{t('contact.idea')}</h3>
      </div>

      <div class="form-row">
        <div class="form-field">
          <label for="contact-name">{t('contact.name')}</label>
          <input id="contact-name" name="name" type="text" autocomplete="name" minlength="2" maxlength="80" required placeholder={t('contact.placeholders.name')} aria-describedby="contact-name-error" />
          <p id="contact-name-error" class="field-error" data-error-for="name"></p>
        </div>
        <div class="form-field">
          <label for="contact-email">{t('contact.email')}</label>
          <input id="contact-email" name="email" type="email" autocomplete="email" maxlength="254" required placeholder={t('contact.placeholders.email')} aria-describedby="contact-email-error" />
          <p id="contact-email-error" class="field-error" data-error-for="email"></p>
        </div>
      </div>

      <div class="form-field">
        <label for="contact-subject">{t('contact.subject')}</label>
        <input id="contact-subject" name="subject" type="text" minlength="3" maxlength="120" required placeholder={t('contact.placeholders.subject')} aria-describedby="contact-subject-error" />
        <p id="contact-subject-error" class="field-error" data-error-for="subject"></p>
      </div>

      <div class="form-field">
        <label for="contact-message">{t('contact.message')}</label>
        <textarea id="contact-message" name="message" minlength="10" maxlength="3000" required placeholder={t('contact.placeholders.message')} aria-describedby="contact-message-error"></textarea>
        <p id="contact-message-error" class="field-error" data-error-for="message"></p>
      </div>

      <div class="contact-honeypot" aria-hidden="true" hidden>
        <label for="contact-website">Website</label>
        <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <div class="contact-form-footer">
        <p class="contact-protection"><span aria-hidden="true">✓</span>{t('contact.protection')}</p>
        <button type="submit">{t('contact.send')}</button>
      </div>
      <p class="form-status" role="status" aria-live="polite" aria-atomic="true"></p>
    </form>
  </div>
</section>

<script>
  import '../scripts/contact-form';
</script>