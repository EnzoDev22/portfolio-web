---
import DownloadIcon from './icons/DownloadIcon.astro';
---

<section id="inicio" class="panel hero" aria-labelledby="hero-title" data-reveal-section>
  <div class="hero-main">
    <div class="hero-profile">
      <div class="portrait-wrap">
        <img src="/assets/portrait-enzo.webp" width="1043" height="1043" alt="Retrato de Enzo Jesuan Del Sole" fetchpriority="high" />
      </div>
    </div>
    <div class="hero-copy">
      <p class="hero-intro">
        <span class="lang-es">Hola, soy </span><span class="lang-en">Hi, I am </span>
        <strong class="hero-typewriter">
          <span aria-hidden="true" data-hero-typewriter data-text-es-first="Desarrollador Full Stack" data-text-en-first="Full Stack Developer" data-text-second="Enzo Jesuan Del Sole"></span>
          <span class="hero-typewriter__accessible" data-hero-typewriter-label>Desarrollador Full Stack</span>
        </strong>
      </p>
      <h1 id="hero-title">
        <span class="lang-es">Código sólido. <em>ADAPTABILIDAD</em> constante.</span>
        <span class="lang-en">I develop software with <em>INTENT</em>.</span>
      </h1>
      <p class="lang-es">Construyo soluciones claras y confiables, adaptándome a las necesidades y tecnologías de cada proyecto.</p>
      <p class="lang-en">I build clear, reliable solutions, adapting to the needs and technologies of each project.</p>
      <div class="hero-actions">
        <a class="cv-button" href="/cv-enzo-del-sole.pdf" download>
          <DownloadIcon />
          <span class="lang-es">Descargar CV</span><span class="lang-en">Download résumé</span>
        </a>
        <a
          class="hero-social-link"
          href="https://linkedin.com/in/enzo-jesuan-del-sole"
          target="_blank"
          rel="noreferrer"
          aria-label="Visitar mi perfil de LinkedIn"
        >
          <span class="hero-social-icon hero-social-icon--linkedin" aria-hidden="true"></span>
        </a>
        <a
          class="hero-social-link"
          href="https://github.com/EnzoDev22"
          target="_blank"
          rel="noreferrer"
          aria-label="Visitar mi perfil de GitHub"
        >
          <span class="hero-social-icon hero-social-icon--github" aria-hidden="true"></span>
        </a>
      </div>
    </div>
  </div>
  <a class="hero-scroll-indicator" href="#proyectos" aria-label="Ir a la sección Proyectos">
    <span class="hero-scroll-indicator__mouse" aria-hidden="true"></span>
  </a>
</section>

<script>
  const typewriter = document.querySelector<HTMLElement>('[data-hero-typewriter]');
  const typewriterLabel = document.querySelector<HTMLElement>('[data-hero-typewriter-label]');

  if (typewriter) {
    const root = document.documentElement;
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    let timer: number | undefined;
    let cycle = 0;

    const restart = () => {
      cycle += 1;
      window.clearTimeout(timer);

      const currentCycle = cycle;
      const texts = root.dataset.lang === 'en'
        ? [typewriter.dataset.textEnFirst!, typewriter.dataset.textSecond!]
        : [typewriter.dataset.textEsFirst!, typewriter.dataset.textSecond!];
      let textIndex = 0;

      if (reducedMotion.matches) {
        typewriter.textContent = texts[0];
        if (typewriterLabel) typewriterLabel.textContent = texts[0];
        return;
      }

      let index = 0;
      const type = () => {
        if (currentCycle !== cycle) return;
        const text = texts[textIndex];
        if (index === 0 && typewriterLabel) typewriterLabel.textContent = text;
        typewriter.textContent = text.slice(0, index);
        if (index < text.length) {
          index += 1;
          timer = window.setTimeout(type, 70);
          return;
        }
        timer = window.setTimeout(erase, 1500);
      };

      const erase = () => {
        if (currentCycle !== cycle) return;
        const text = texts[textIndex];
        typewriter.textContent = text.slice(0, index);
        if (index > 0) {
          index -= 1;
          timer = window.setTimeout(erase, 40);
          return;
        }
        textIndex = (textIndex + 1) % texts.length;
        timer = window.setTimeout(type, 450);
      };

      type();
    };

    new MutationObserver(restart).observe(root, { attributes: true, attributeFilter: ['data-lang'] });
    reducedMotion.addEventListener('change', restart);
    restart();
  }
</script>
