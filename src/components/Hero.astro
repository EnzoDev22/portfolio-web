---
import DownloadIcon from './icons/DownloadIcon.astro';
import { Image } from 'astro:assets';
import { t } from 'i18next';
import portraitEnzo from '../assets/portrait-enzo.webp';

interface Props {
  locale: 'es' | 'en';
}

const { locale } = Astro.props;
const cvHref = `/cv-enzo-del-sole-${locale}.pdf`;
---

<section id="inicio" class="panel flex min-h-[calc(100svh-76px)] flex-col items-stretch px-1 pt-[clamp(16px,4svh,42px)] pb-3 [@media(max-width:639px)_and_(max-height:700px)]:py-2 sm:px-3 min-[900px]:min-h-[calc(100svh-104px)] min-[900px]:px-[clamp(34px,5vw,68px)] min-[900px]:pt-0 min-[900px]:pb-5" aria-labelledby="hero-title" data-reveal-section>
  <div class="flex w-full min-w-0 flex-1 flex-col items-start justify-center gap-[clamp(18px,4svh,36px)] [@media(max-width:639px)_and_(max-height:700px)]:gap-2.5 min-[900px]:flex-row-reverse min-[900px]:items-center min-[900px]:gap-[clamp(48px,6vw,80px)]">
    <div class="flex w-[min(78vw,270px)] flex-col items-center self-center [@media(max-width:639px)_and_(max-height:700px)]:w-[min(36vw,130px)] min-[900px]:w-[clamp(300px,32vw,400px)] min-[900px]:flex-[0_0_clamp(300px,32vw,400px)]">
      <div class="w-full overflow-hidden border border-solid border-[color:var(--line-strong)] rounded-[3px_42px_3px_42px] bg-[var(--surface-soft)] shadow-[9px_9px_0_var(--accent)] aspect-square min-[900px]:rounded-[4px_68px_4px_68px] min-[900px]:shadow-[14px_14px_0_var(--accent)]">
        <Image
          class="h-full w-full scale-[1.13] object-cover object-[center_8%]"
          src={portraitEnzo}
          alt={t('hero.portraitAlt')}
          layout="full-width"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </div>
    </div>
    <div class="flex w-full min-w-0 flex-col items-start">
      <p class="m-0 mb-3.5 max-w-none text-[length:clamp(.84rem,3vw,1rem)] leading-[1.4] font-medium tracking-[.025em] text-[color:var(--muted)] [@media(max-width:639px)_and_(max-height:700px)]:mb-2">
        {t('hero.intro')}{' '}
        <strong class="inline-flex max-w-full items-baseline whitespace-nowrap !text-[color:var(--accent)] font-bold after:ml-[3px] after:h-[1em] after:w-[2px] after:bg-current after:content-[''] after:animate-[hero-typewriter-caret_.8s_step-end_infinite] motion-reduce:after:animate-none motion-reduce:after:opacity-0">
          <span aria-hidden="true" data-hero-typewriter data-text-first={t('hero.first')} data-text-second={t('hero.second')}></span>
          <span class="sr-only" data-hero-typewriter-label>{t('hero.first')}</span>
        </strong>
      </p>
      <h1 id="hero-title" class="m-0 max-w-[12ch] text-[length:clamp(2.35rem,11.5vw,4.35rem)] leading-[.94] font-extrabold tracking-[-.06em] text-balance min-[900px]:text-[length:clamp(3.4rem,4.6vw,4.75rem)]">
        {t('hero.title')}
      </h1>
      <p class="mt-5 max-w-[54ch] text-[.96rem] leading-[1.75] text-[color:var(--muted)] [@media(max-width:639px)_and_(max-height:700px)]:mt-3 min-[900px]:text-[1.03rem]">{t('hero.copy')}</p>
      <div class="mt-7 flex w-full flex-wrap items-center gap-2.5 [@media(max-width:639px)_and_(max-height:700px)]:mt-3.5 sm:w-auto">
        <a class="inline-flex min-h-12 flex-[1_1_140px] items-center justify-center gap-[9px] rounded-full border border-solid border-[color:var(--accent)] bg-[var(--accent)] px-[15px] py-[11px] text-[.8rem] font-semibold !text-[#0b1a0d] transition-[background-color,border-color,transform] duration-[180ms] ease-[ease] hover:-translate-y-0.5 hover:border-[color:var(--accent-strong)] hover:bg-[var(--accent-strong)] focus-visible:-translate-y-0.5 focus-visible:border-[color:var(--accent-strong)] focus-visible:bg-[var(--accent-strong)] sm:flex-none [&>svg]:h-[18px] [&>svg]:w-[17px] [&>svg]:shrink-0" href={cvHref} download>
          <DownloadIcon />
          {t('hero.download')}
        </a>
        <a
          class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-solid border-[color:var(--accent)] bg-[var(--accent)] !text-[#0b1a0d] transition-[background-color,border-color,transform] duration-[180ms] ease-[ease] hover:-translate-y-0.5 hover:border-[color:var(--accent-strong)] hover:bg-[var(--accent-strong)] focus-visible:-translate-y-0.5 focus-visible:border-[color:var(--accent-strong)] focus-visible:bg-[var(--accent-strong)]"
          href="https://linkedin.com/in/enzo-jesuan-del-sole"
          target="_blank"
          rel="noreferrer"
          aria-label="LinkedIn"
        >
          <span class="h-5 w-5 shrink-0 bg-current [-webkit-mask:url('/assets/brand-linkedin.svg')_center_/_contain_no-repeat] [mask:url('/assets/brand-linkedin.svg')_center_/_contain_no-repeat]" aria-hidden="true"></span>
        </a>
        <a
          class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-solid border-[color:var(--accent)] bg-[var(--accent)] !text-[#0b1a0d] transition-[background-color,border-color,transform] duration-[180ms] ease-[ease] hover:-translate-y-0.5 hover:border-[color:var(--accent-strong)] hover:bg-[var(--accent-strong)] focus-visible:-translate-y-0.5 focus-visible:border-[color:var(--accent-strong)] focus-visible:bg-[var(--accent-strong)]"
          href="https://github.com/EnzoDev22"
          target="_blank"
          rel="noreferrer"
          aria-label="GitHub"
        >
          <span class="h-5 w-5 shrink-0 bg-current [-webkit-mask:url('/assets/brand-github.svg')_center_/_contain_no-repeat] [mask:url('/assets/brand-github.svg')_center_/_contain_no-repeat]" aria-hidden="true"></span>
        </a>
      </div>
    </div>
  </div>
  <a class="mx-auto mt-3 inline-flex min-h-11 min-w-11 items-center justify-center gap-2.5 px-1 py-0.5 text-[.78rem] leading-[1.4] font-semibold text-[color:var(--accent)] transition-colors duration-[180ms] ease-[ease] hover:text-[color:var(--accent-strong)] focus-visible:text-[color:var(--accent-strong)] focus-visible:outline-2 focus-visible:outline-[color:var(--accent-strong)] focus-visible:outline-offset-4 dark:hover:text-[color:var(--accent)] dark:focus-visible:text-[color:var(--accent)] dark:focus-visible:outline-[color:var(--accent)] [@media(max-width:639px)_and_(max-height:700px)]:mt-0" href="#proyectos" aria-label={t('nav.projects')}>
    <span class="!text-[color:var(--accent)] relative h-[38px] w-6 shrink-0 overflow-hidden rounded-full border-2 border-solid border-current before:absolute before:top-1.5 before:left-1/2 before:h-[5px] before:w-[5px] before:-translate-x-1/2 before:rounded-full before:bg-current before:content-[''] before:animate-[hero-scroll-wheel_1.4s_ease-out_infinite] motion-reduce:before:animate-none" aria-hidden="true"></span>
  </a>
</section>

<script>
  const typewriter = document.querySelector<HTMLElement>('[data-hero-typewriter]');
  const typewriterLabel = document.querySelector<HTMLElement>('[data-hero-typewriter-label]');

  if (typewriter) {
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    let timer: number | undefined;
    let cycle = 0;

    const restart = () => {
      cycle += 1;
      window.clearTimeout(timer);

      const currentCycle = cycle;
      const texts = [typewriter.dataset.textFirst!, typewriter.dataset.textSecond!];
      let textIndex = 0;

      if (reducedMotion.matches) {
        typewriter.textContent = texts[0];
        if (typewriterLabel) typewriterLabel.textContent = texts[0];
        return;
      }

      let index = 0;
      const type = () => {
        if (currentCycle !== cycle) return;
        const text = texts[textIndex];
        if (index === 0 && typewriterLabel) typewriterLabel.textContent = text;
        typewriter.textContent = text.slice(0, index);
        if (index < text.length) {
          index += 1;
          timer = window.setTimeout(type, 70);
          return;
        }
        timer = window.setTimeout(erase, 1500);
      };

      const erase = () => {
        if (currentCycle !== cycle) return;
        const text = texts[textIndex];
        typewriter.textContent = text.slice(0, index);
        if (index > 0) {
          index -= 1;
          timer = window.setTimeout(erase, 40);
          return;
        }
        textIndex = (textIndex + 1) % texts.length;
        timer = window.setTimeout(type, 450);
      };

      type();
    };

    reducedMotion.addEventListener('change', restart);
    restart();
  }
</script>