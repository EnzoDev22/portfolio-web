---
import { t } from 'i18next';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <p class="site-footer__signature">
      <span>{year}</span>
      <span aria-hidden="true">/</span>
      <span>Enzo Jesuan Del Sole</span>
      <span aria-hidden="true">/</span>
      <span>{t('footer.role')}</span>
      <span aria-hidden="true">/</span>
      <a href="https://github.com/EnzoDev22" target="_blank" rel="noreferrer">@EnzoDev22</a>
    </p>

    <nav class="site-footer__socials" aria-label={t('footer.social')}>
      <a href="https://github.com/EnzoDev22" target="_blank" rel="noreferrer" aria-label={t('footer.github')}>
        <span class="site-footer__social-icon site-footer__social-icon--github" aria-hidden="true"></span>
      </a>
      <a href="https://linkedin.com/in/enzo-jesuan-del-sole" target="_blank" rel="noreferrer" aria-label={t('footer.linkedin')}>
        <span class="site-footer__social-icon site-footer__social-icon--linkedin" aria-hidden="true"></span>
      </a>
    </nav>
  </div>
</footer>